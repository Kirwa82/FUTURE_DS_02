model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Customer Data","Age Groups","Credit Score Groups","Acc Balance Groups"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Customer Data'
ref table 'Age Groups'
ref table 'Credit Score Groups'
ref table 'Acc Balance Groups'

ref cultureInfo en-US

